{
  "_comment": "bio/固定ポスト/投稿用の転送ホスト（usephys.net）。target を変えたら `python3 scripts/redirect_build.py --apply` で反映。paths を持つホストは `https://<host>/<key>` でキーごとに転送先を変えられる（差し替え前提の導線用）。dynamic を持つホストは URL のパスから転送先を組み立てる（post.usephys.net/<note記事ID> → その記事。記事ごとの設定は不要）。知らないキーは host の target に落ちる。クローラ（Twitterbot 等）には 302 で転送先へ飛ばし、note 本体の OG でカードを作らせる",
  "domain": "usephys.net",
  "server_ip": "133.18.181.39",
  "hosts": {
    "usephys.net": {
      "label": "X bio",
      "column": "X bio",
      "target": "https://note.com/takaesu7431/n/n4ce6fbbf837f?sub_rt=share_sb"
    },
    "threads.usephys.net": {
      "label": "Threads bio",
      "column": "Threads bio",
      "target": "https://note.com/takaesu7431/n/n4ce6fbbf837f?sub_rt=share_sb"
    },
    "note.usephys.net": {
      "label": "X 固定ポスト",
      "column": "X 固定",
      "target": "https://note.com/takaesu7431/n/n4ce6fbbf837f?sub_rt=share_sb"
    },
    "tnote.usephys.net": {
      "label": "Threads 固定ポスト",
      "column": "Threads 固定",
      "target": "https://note.com/takaesu7431/n/n4ce6fbbf837f?sub_rt=share_sb"
    },
    "post.usephys.net": {
      "label": "Threads 投稿",
      "column": "Threads 投稿",
      "target": "https://note.com/takaesu7431/n/n4ce6fbbf837f?sub_rt=share_sb",
      "dynamic": {
        "_comment": "note の URL `note.com/takaesu7431/n/<ID>` の <ID> を `https://post.usephys.net/<ID>` として貼る。{1} に ID が入る。パラメータは転送側で付けるので貼るときは不要",
        "pattern": "^/(n[0-9a-f]{10,16})/?$",
        "target": "https://note.com/takaesu7431/n/{1}?sub_rt=share_sb"
