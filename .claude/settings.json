{
  "autoMemoryEnabled": false,
  "env": {
    "GOOGLE_PROJECT_ID": "charming-well-464402-u4"
  },
  "permissions": {
    "deny": [
      "Write(.claude/settings.local.json)",
      "Edit(.claude/settings.local.json)"
    ],
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Bash(curl -s http://127.0.0.1:8000*)",
      "Bash(python3 *notebooklm_manager.py make-infographic*)",
      "Bash(python3 *notebooklm_manager.py infographic *)",
      "Bash(git -C *xClaude push)",
      "Bash(git -C *xClaude add *)",
      "Bash(git -C *xClaude commit *)",
      "Bash(git -C *xClaude status)",
      "Bash(git -C *xClaude diff *)",
      "Bash(git -C *xClaude log *)",
      "Bash(git rev-parse *)",
      "Bash(bash *scripts/sync_to_drive.sh)",
      "Bash(bash *scripts/drive_put.sh *)",
      "Bash(bash *scripts/drive_get.sh *)",
      "Bash(bash *scripts/post_from_email.sh *)",
      "Bash(bash *scripts/send_gmail.sh *)",
      "Bash(bash *scripts/create_gmail_draft.sh *)",
      "Bash(*commit_and_sync.sh *)",
      "Bash(rm *xClaude/outputs/infographic_*)",
      "Bash(gws gmail users threads modify *)",
      "Bash(gws sheets spreadsheets values get *)",
      "Bash(gws drive +upload *)",
      "Bash(mkdir -p *)",
      "Bash(cp -r *)",
      "Bash(npm *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(sed *)",
      "Bash(date *)",
      "Bash(wc *)",
      "Bash(python3 -c *)",
      "Bash(gh run list *)",
      "Bash(git stash *)",
      "Bash(git restore *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status*)",
      "Bash(git mv *)",
      "Bash(git show *)",
      "Bash(tail *)",
      "Bash(python3 *update_wiki_skills.py*)",
      "Bash(python3 *save_session_history.py*)",
      "Bash(python3 *notebooklm_manager.py ask *)",
      "Bash(printf *)",
      "Bash(tee *)",
      "Bash(bash *scripts/drive_put_folder.sh *)",
      "Bash(cp *)",
      "Bash(gws drive files create *)",
      "Bash(gws drive files list *)",
      "Bash(gws drive files get *)",
      "WebSearch",
      "WebFetch",
      "mcp__mcp-gsheets__sheets_check_access",
      "mcp__mcp-gsheets__sheets_get_metadata",
      "mcp__mcp-gsheets__sheets_get_values",
      "mcp__mcp-gsheets__sheets_batch_get_values",
      "mcp__mcp-gsheets__sheets_append_values",
      "mcp__mcp-gsheets__sheets_update_values",
      "mcp__claude_ai_Gmail__search_threads",
      "mcp__claude_ai_Gmail__get_thread",
      "mcp__claude_ai_Gmail__create_draft",
      "mcp__claude_ai_Gmail__list_drafts",
      "mcp__claude_ai_Gmail__create_label",
      "mcp__claude_ai_Gmail__list_labels",
      "mcp__claude_ai_Gmail__label_thread",
      "mcp__claude_ai_Gmail__unlabel_thread",
      "mcp__claude_ai_Google_Drive__search_files",
      "mcp__claude_ai_Google_Drive__read_file_content"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pkill -f '.venv/bin/python -u server.py' 2>/dev/null; [ -d \"$CLAUDE_PROJECT_DIR/xmcp\" ] && cd \"$CLAUDE_PROJECT_DIR/xmcp\" && nohup .venv/bin/python -u server.py > /tmp/xmcp.log 2>&1 &",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash(git -C *xClaude commit *)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/update_wiki_skills.py\" || true"
          }
        ]
      },
      {
        "matcher": "mcp__github__push_files",
        "hooks": [
          {
            "type": "command",
            "command": "echo '⚠ master に push しました と必ず伝えること'"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "xmcp": {
      "type": "http",
      "url": "http://127.0.0.1:8000/mcp"
    }
  }
}
