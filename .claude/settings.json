{
  "permissions": {
    "allow": [
      "Read",
      "Bash(curl -s http://127.0.0.1:8000*)",
      "Bash(python3 /root/xClaude/scripts/notebooklm_manager.py make-infographic)",
      "Bash(git -C /root/xClaude push)",
      "Bash(git -C /root/xClaude add *)",
      "Bash(git -C /root/xClaude commit *)",
      "Bash(git -C /root/xClaude status)",
      "Bash(python3 $(git rev-parse --show-toplevel)/scripts/notebooklm_manager.py make-infographic *)",
      "Bash(bash $(git rev-parse --show-toplevel)/scripts/sync_to_drive.sh)",
      "Bash(bash $(git rev-parse --show-toplevel)/scripts/sync_to_sheets.sh)",
      "Bash(bash $(git rev-parse --show-toplevel)/scripts/drive_put.sh *)",
      "Bash(bash $(git rev-parse --show-toplevel)/scripts/drive_get.sh *)",
      "Bash(bash $(git rev-parse --show-toplevel)/scripts/post_from_email.sh *)",
      "Bash(bash $(git rev-parse --show-toplevel)/scripts/send_gmail.sh *)",
      "Bash(bash $(git rev-parse --show-toplevel)/scripts/commit_and_sync.sh *)",
      "Bash(python3 $(git rev-parse --show-toplevel)/scripts/csv_reader.py *)",
      "Bash(python3 $(git rev-parse --show-toplevel)/scripts/update_neta_status.py *)",
      "Bash(gws gmail users threads modify *)",
      "Write",
      "Edit",
      "Bash(mkdir -p *)",
      "Bash(cp -r *)",
      "Bash(npm *)",
      "Bash(grep *)",
      "Bash(gws sheets spreadsheets get *)",
      "Bash(gws sheets spreadsheets values get *)",
      "Bash(git -C /root/xClaude diff *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import json,sys; cmd=json.load(sys.stdin).get('tool_input',{}).get('command',''); exit(0 if 'git commit' in cmd or 'commit_and_sync.sh' in cmd else 1)\" && echo '{\"systemMessage\": \"コミット前確認: 今回のセッションで新規に許可した操作（Bash/Tool）を settings.json に追記しましたか？\"}' || true"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "xmcp": {
      "type": "http",
      "url": "http://127.0.0.1:8000/mcp"
    }
  }
}
