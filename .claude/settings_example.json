{
  "mcpServers": {
    "xmcp": {
      "type": "http",
      "url": "http://127.0.0.1:8000/mcp"
    },
    "mcp-gsheets": {
      "command": "npx",
      "args": ["-y", "mcp-gsheets@latest"],
      "env": {
        "GOOGLE_PROJECT_ID": "your-gcp-project-id",
        "GOOGLE_APPLICATION_CREDENTIALS": "/path/to/your-service-account-key.json"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pkill -f 'python server.py' 2>/dev/null; cd /path/to/xmcp && .venv/bin/python server.py > /tmp/xmcp.log 2>&1 &",
            "async": true
          }
        ]
      }
    ]
  }
}
